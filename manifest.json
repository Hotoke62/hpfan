{
  "schemaVersion": 1,
  "id": "vee.hpfan",
  "name": "HP Fan Monitor",
  "version": "0.5.0",
  "author": "Vatsal Visani",
  "license": "MIT",
  "description": "Temperature, CPU profiles, and verified fan control for the HP EliteBook 840 G4",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "HpfanPanel.qml"
  },
  "barWidget": {
    "displayName": "HP Fan Monitor",
    "description": "Interactive temperature and CPU-profile panel with honest fan-control capability reporting.",
    "category": "System",
    "aliases": [
      "fan",
      "temperature",
      "thermal",
      "hp"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMs": 2000,
      "displayMode": "Compact"
    },
    "schema": [
      {
        "key": "displayMode",
        "type": "enum",
        "label": "Bar appearance",
        "options": [
          "Compact",
          "Detailed"
        ],
        "defaultValue": "Compact",
        "description": "Compact shows temperature and abbreviated RPM; Detailed also shows full RPM and the CPU profile."
      },
      {
        "key": "refreshIntervalMs",
        "type": "integer",
        "label": "Refresh interval",
        "min": 500,
        "max": 10000,
        "step": 500,
        "defaultValue": 2000,
        "description": "Milliseconds between read-only sensor updates."
      }
    ]
  }
}
